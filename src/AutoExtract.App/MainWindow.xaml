<Window x:Class="AutoExtract.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AutoExtract · 자동 압축 해제" Width="980" Height="800" MinWidth="760" MinHeight="580" FontFamily="Malgun Gothic" FontSize="13" Background="#F3F5F8" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
   <TextBlock Text="AutoExtract" FontSize="28" FontWeight="SemiBold" Foreground="#233A66"/>
   <TextBlock Text="다운로드가 끝나면, 압축 해제까지 자동으로" Foreground="#596579" Margin="0,4,0,12"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="감시 시작 / 일시정지" Command="{Binding TogglePause}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Status}" FontSize="19" FontWeight="SemiBold" Foreground="#24654C"/><TextBlock Text="{Binding FolderCount}" Margin="18,6,0,0" Foreground="#596579"/></StackPanel></DockPanel>
   <TextBlock Text="{Binding Recent}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#5E5064" Margin="0,0,0,10"/><Button Content="설정 저장" Command="{Binding Save}" HorizontalAlignment="Right" Background="#DDE9FF" FontWeight="SemiBold"/></StackPanel>
  <TabControl x:Name="Tabs">
   <TabItem Header="감시 및 설정"><ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <GroupBox Header="감시 폴더"><StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="폴더 추가" Command="{Binding AddFolder}"/><Button Content="폴더 제거" Command="{Binding RemoveFolder}"/></StackPanel>
     <DataGrid ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" AutoGenerateColumns="False" CanUserAddRows="False" Height="175" HeadersVisibility="Column"><DataGrid.Columns>
      <DataGridCheckBoxColumn Header="활성" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
      <DataGridTextColumn Header="폴더 경로" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
      <DataGridCheckBoxColumn Header="하위 폴더 포함" Binding="{Binding IncludeSubdirectories, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
     </DataGrid.Columns></DataGrid>
    </StackPanel></GroupBox>
    <GroupBox Header="압축 해제 설정"><StackPanel>
     <TextBlock Text="압축 해제 위치: 압축파일과 같은 위치의 파일명 폴더" Margin="0,0,0,8"/>
     <TextBlock Text="같은 폴더가 있으면 (2), (3)으로 생성합니다. 기존 파일을 덮어쓰지 않습니다." Foreground="#596579" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <CheckBox Content="성공 시 원본 압축파일을 휴지통으로 이동 (해제하면 원본 유지)" IsChecked="{Binding Settings.RecycleOriginal}" Margin="0,0,0,12"/>
     <CheckBox Content="Windows 로그인 시 자동 실행" IsChecked="{Binding Settings.AutoStart}" Margin="0,0,0,16"/>
     <TextBlock Text="반디집 실행 파일 (비워 두면 자동 탐색)" Margin="0,0,0,6"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseEngine}" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.BandizipPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
    </StackPanel></GroupBox>
    <GroupBox Header="저장 암호"><StackPanel>
     <TextBlock Text="빈 암호 검사에 실패하면 아래 순서대로 시도합니다. 모두 실패하면 원본을 보존합니다." TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock Text="암호는 현재 Windows 계정으로 암호화해 저장합니다. 이름에는 암호를 적지 마세요." Foreground="#596579" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <DockPanel Margin="0,0,0,8"><TextBlock Text="이름 (선택)" VerticalAlignment="Center" Width="90"/><TextBox Text="{Binding PasswordName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/></DockPanel>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="암호 추가" Click="AddPassword_Click"/><TextBlock Text="암호" VerticalAlignment="Center" Width="90"/><PasswordBox x:Name="NewPassword" MaxLength="1024" Padding="6" VerticalContentAlignment="Center"/></DockPanel>
     <ListBox ItemsSource="{Binding Passwords}" SelectedItem="{Binding SelectedPassword}" DisplayMemberPath="Name" Height="95" AutomationProperties.Name="저장된 암호 목록"/>
     <Button Content="선택한 암호 삭제" Command="{Binding RemovePassword}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    </StackPanel></GroupBox>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="작업 기록"><DockPanel Margin="14"><DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="기록 전체 삭제" Command="{Binding ClearHistory}" ToolTip="저장된 작업 기록만 삭제합니다. 결과 폴더와 중복 처리 방지 정보는 유지됩니다."/><Button Content="선택한 결과 폴더 열기" Command="{Binding OpenOutput}" HorizontalAlignment="Right" Margin="0"/></DockPanel><DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
    <DataGridTextColumn Header="처리 시간" Binding="{Binding Time, StringFormat=MM-dd HH:mm:ss}" Width="120"/>
    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90"/>
    <DataGridTextColumn Header="파일" Binding="{Binding File}" Width="210"/>
    <DataGridTextColumn Header="설명 / 실패 원인" Binding="{Binding Detail}" Width="*"/>
   </DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
